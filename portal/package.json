{
  "name": "auratio-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:rubric-anchors",
    "dev": "vite",
    "prebuild": "npm run generate:rubric-anchors",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run check:rubric-anchors && node scripts/verify_step_iv_hardening.mjs && node scripts/verify_interactions.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "capture": "node scripts/capture.mjs",
    "generate:rubric-anchors": "node scripts/generate-rubric-anchors.mjs",
    "check:rubric-anchors": "node scripts/generate-rubric-anchors.mjs --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
